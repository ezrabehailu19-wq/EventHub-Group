# Copy to .env and fill in for non-Docker local runs.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=eventhub
DB_USER=eventhub
DB_PASSWORD=eventhub

REDIS_HOST=localhost
REDIS_PORT=6379

# Must be at least 32 bytes for HMAC-SHA256.
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Chapa payment integration
CHAPA_SECRET_KEY=replace-with-your-chapa-secret

LOG_LEVEL=INFO